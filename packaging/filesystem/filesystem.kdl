schema-version 1 kind="package-manifest"
package "system/filesystem" publisher="canopa-usr-base" version="1.0.0-0" {
    dir "usr" mode="0755"
    dir "usr/bin" mode="0755"
    dir "usr/lib" mode="0755"
    symlink "bin" target="usr/bin"
    symlink "sbin" target="usr/bin"
    symlink "lib" target="usr/lib"
    symlink "lib64" target="usr/lib" architecture="x86_64"
    symlink "usr/sbin" target="bin"
    symlink "usr/lib64" target="lib" architecture="x86_64"
}
