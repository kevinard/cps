schema-version 1 kind="package-manifest"
package "system/busybox" publisher="canopa-bootstrap" version="1.38.0-1" {
    file "usr/bin/busybox" mode="0755"
    symlink "usr/bin/insmod" target="busybox"
    symlink "usr/bin/sh" target="busybox"
    file "usr/share/licenses/busybox/LICENSE" mode="0644"
}
