schema-version 1 kind="build-recipe"
build architecture="x86_64" epoch=1793361987 {
    toolchain solver="sat-v2" {
        publisher "seed" catalog="@CATALOG_SHA256@" key-sha256="@KEY_SHA256@"
        package "build/native-kernel"
    }
    manifest "kernel.kdl" sha256="@MANIFEST_SHA256@"
    source "linux-6.12.115.tar.xz" size=148760708 sha256="0ec90fe4b20422b1b664b77e6d2dde22b40bd41e7eb2cad8ac8739a4749cb1bb" url="https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.12.115.tar.xz"
    source "vm.config" size=@CONFIG_SIZE@ sha256="@CONFIG_SHA256@"
    script """
    command -v readelf >/dev/null
    tar -xf "$CPS_SOURCES/linux-6.12.115.tar.xz"
    cd linux-6.12.115
    export ARCH=x86_64 LOCALVERSION=@LOCALVERSION@ KBUILD_BUILD_USER=cps KBUILD_BUILD_HOST=build
    export KBUILD_BUILD_VERSION=1 KBUILD_BUILD_TIMESTAMP="$(date -u -d "@$SOURCE_DATE_EPOCH" '+%a %b %d %T UTC %Y')"
    make KCONFIG_ALLCONFIG="$CPS_SOURCES/vm.config" allnoconfig
    while IFS= read -r setting; do
        grep -Fxq "$setting" .config || { echo "Kernel configuration dropped $setting" >&2; exit 1; }
    done < "$CPS_SOURCES/vm.config"
    release=$(make -s kernelrelease)
    test "$release" = @KERNEL_RELEASE@
    make -j4 bzImage
    install -Dm644 arch/x86/boot/bzImage "$DESTDIR/usr/lib/modules/$release/vmlinuz"
    install -Dm644 .config "$DESTDIR/usr/lib/modules/$release/config"
    install -Dm644 LICENSES/preferred/GPL-2.0 "$DESTDIR/usr/share/licenses/kernel-qemu/GPL-2.0"
    """
}
