schema-version 1 kind="package-manifest"
package "system/cps" publisher="canopa" version="0.1.0-41" architecture="x86_64" {
    require "system/elf-runtime"
    require "system/libseccomp" version=">=2.6.1-1"
    require "system/sqlite" version=">=3.54.1-1"
    file "usr/bin/cps" mode="0755"
    file "usr/lib/systemd/system/cps-boot-health.service" mode="0644"
    file "usr/lib/systemd/system/cps-finalize-trial.path" mode="0644"
    file "usr/lib/systemd/system/cps-finalize-trial.service" mode="0644"
    file "usr/lib/systemd/system/cps-mirror-rank.service" mode="0644"
    file "usr/lib/systemd/system/cps-mirror-rank.timer" mode="0644"
    file "usr/lib/systemd/system/cps-repo-refresh@.service" mode="0644"
    file "usr/lib/systemd/system/cps-repo-refresh@.timer" mode="0644"
    file "usr/lib/systemd/system/cps-repo-replicate@.service" mode="0644"
    file "usr/lib/systemd/system/cps-repo-replicate@.timer" mode="0644"
    file "usr/lib/systemd/system/cps-uefi-bless.service" mode="0644"
    file "usr/share/man/man1/cps-abort.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-apply.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-autoremove.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-boot.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-build.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-config.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-contents.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-debug.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-deps.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-develop.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-facet.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-fetch.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-freeze.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-history.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-image.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-info.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-install.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-list.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-manifest.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-mark.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-mediator.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-owner.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-policy.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-publish.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-publisher.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-rdeps.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-recipe.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-remove.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-repair.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-repo.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-resume.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-revert.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-search.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-source.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-status.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-unfreeze.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-upgrade.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-variant.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-verify.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps-why.1" mode="0644" facet="doc.man"
    file "usr/share/man/man1/cps.1" mode="0644" facet="doc.man"
    file "usr/share/licenses/cps/LICENSE" mode="0644"
    symlink "usr/lib/systemd/system/boot-complete.target.requires/cps-boot-health.service" target="../cps-boot-health.service"
    symlink "usr/lib/systemd/system/multi-user.target.wants/cps-finalize-trial.path" target="../cps-finalize-trial.path"
}
