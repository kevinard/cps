schema-version 1
package "system/cps" publisher="canopa" version="0.1.0-5" architecture="x86_64" {
    require "system/elf-runtime"
    require "system/libseccomp" version=">=2.6.1-1"
    require "system/sqlite" version=">=3.54.1-1"
    file "usr/bin/cps" mode="0755" uid=0 gid=0
    file "usr/lib/systemd/system/cps-boot-health.service" mode="0644" uid=0 gid=0
    symlink "usr/lib/systemd/system/boot-complete.target.requires/cps-boot-health.service" target="../cps-boot-health.service" uid=0 gid=0
}
