schema-version 1 kind="build-recipe"
build architecture="x86_64" epoch=1744301157 {
    toolchain solver="sat-v2" {
        publisher "seed" catalog="@CATALOG_SHA256@" key-sha256="@KEY_SHA256@"
        package "build/native-gnu"
    }
    manifest "grep.kdl" sha256="@MANIFEST_SHA256@"
    source "grep-3.12.tar.xz" size=1918448 sha256="2649b27c0e90e632eadcd757be06c6e9a4f48d941de51e7c0f83ff76408a07b9" url="https://ftp.gnu.org/gnu/grep/grep-3.12.tar.xz"
    script """
    tar -xJf "$CPS_SOURCES/grep-3.12.tar.xz"
    cd grep-3.12
    CFLAGS="-O2 -fstack-protector-strong -D_FORTIFY_SOURCE=3" LDFLAGS="-Wl,-z,relro,-z,now" \\
        ./configure --prefix=/usr --disable-nls --disable-perl-regexp
    make all
    install -Dm755 src/grep "$DESTDIR/usr/bin/grep"
    install -Dm644 COPYING "$DESTDIR/usr/share/licenses/grep/COPYING"
    """
}
