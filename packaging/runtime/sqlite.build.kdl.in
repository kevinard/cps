schema-version 1
build architecture="@ARCH@" epoch=1791504000 {
    toolchain "@CATALOG_SHA256@" solver="sat-v1" {
        package "build/native-rust"
    }
    manifest "sqlite.kdl" sha256="@MANIFEST_SHA256@"
    source "sqlite-autoconf-3540100.tar.gz" size=3332984 sha256="926ef8d3eab93fbf6e06011901273eec076b25594a4e1cdadd50c987f4f6d64e" url="https://www.sqlite.org/2026/sqlite-autoconf-3540100.tar.gz"
    script """
    tar -xzf "$CPS_SOURCES/sqlite-autoconf-3540100.tar.gz"
    cd sqlite-autoconf-3540100
    cc -O2 -fPIC -shared -Wl,-soname,libsqlite3.so.0 -DSQLITE_ENABLE_COLUMN_METADATA -DSQLITE_ENABLE_FTS5 -DSQLITE_ENABLE_RTREE sqlite3.c -lm -ldl -pthread -o libsqlite3.so.0
    install -Dm755 libsqlite3.so.0 "$DESTDIR/usr/lib/libsqlite3.so.0"
    """
}
