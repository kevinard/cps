[Unit]
Description=Promote a healthy CPS direct UEFI trial and prune old environments
DefaultDependencies=no
Requires=boot-complete.target cps-boot-health.service
After=boot-complete.target multi-user.target cps-boot-health.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/bin/cps boot bless

[Install]
WantedBy=multi-user.target
